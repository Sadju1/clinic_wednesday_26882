{
  "info": {
    "name": "Kigali Clinic - JPA & JPQL Quiz",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" }
  ],
  "item": [
    {
      "name": "A - Derived Queries",
      "item": [
        {
          "name": "A1 - Find patients by last name",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=uwase",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "by-last-name"],
              "query": [
                { "key": "lastName", "value": "uwase" }
              ]
            }
          }
        },
        {
          "name": "A2 - Appointments by status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/by-status?status=SCHEDULED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "by-status"],
              "query": [
                { "key": "status", "value": "SCHEDULED" }
              ]
            }
          }
        },
        {
          "name": "A3 - Appointments in a date range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/between?start=2026-10-01&end=2026-10-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "between"],
              "query": [
                { "key": "start", "value": "2026-10-01" },
                { "key": "end", "value": "2026-10-31" }
              ]
            }
          }
        },
        {
          "name": "A4 - No double booking (conflict demo)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentDate\": \"2026-10-06\",\n  \"reason\": \"Conflict demo\",\n  \"status\": \"SCHEDULED\",\n  \"patient\": { \"id\": \"146ce3fa-63e4-4ab1-9022-40b4d1a64c48\" },\n  \"doctor\": { \"id\": \"2380708c-c90c-47bc-98dd-b45e8e8c52f4\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments/save",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "save"]
            }
          }
        }
      ]
    },
    {
      "name": "B - JPQL Joins",
      "item": [
        {
          "name": "B1 - Doctors by specialization",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/by-specialization?name=cardiology",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "by-specialization"],
              "query": [
                { "key": "name", "value": "cardiology" }
              ]
            }
          }
        },
        {
          "name": "B2 - Doctors without an office",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/without-office",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "without-office"]
            }
          }
        },
        {
          "name": "B3 - Specializations nobody offers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/specializations/unused",
              "host": ["{{baseUrl}}"],
              "path": ["api", "specializations", "unused"]
            }
          }
        },
        {
          "name": "B4 - Patients of a doctor",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/patients/of-doctor/2380708c-c90c-47bc-98dd-b45e8e8c52f4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "of-doctor", "2380708c-c90c-47bc-98dd-b45e8e8c52f4"]
            }
          }
        }
      ]
    },
    {
      "name": "C - Aggregates and Bulk Operations",
      "item": [
        {
          "name": "C1 - Appointments per status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/stats/by-status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "stats", "by-status"]
            }
          }
        },
        {
          "name": "C2 - Frequent patients",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/patients/frequent?min=3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "frequent"],
              "query": [
                { "key": "min", "value": "3" }
              ]
            }
          }
        },
        {
          "name": "C3 - Busiest office",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/offices/busiest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "offices", "busiest"]
            }
          }
        },
        {
          "name": "C4 - Doctor is absent",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/cancel-day?doctorId=f78c2cd1-27c7-455c-babb-1f5545cceb9d&date=2026-10-10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "cancel-day"],
              "query": [
                { "key": "doctorId", "value": "f78c2cd1-27c7-455c-babb-1f5545cceb9d" },
                { "key": "date", "value": "2026-10-10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bonus",
      "item": [
        {
          "name": "Bonus - Appointments page by page",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/page?page=0&size=5&sort=appointmentDate,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "page"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" },
                { "key": "sort", "value": "appointmentDate,desc" }
              ]
            }
          }
        },
        {
          "name": "Bonus - Clean old cancellations",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/cancelled-before?date=2026-10-15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "cancelled-before"],
              "query": [
                { "key": "date", "value": "2026-10-15" }
              ]
            }
          }
        }
      ]
    }
  ]
}
